---
import BaseLayout from '../layouts/BaseLayout.astro';
import categories from '../content/product-examples.json';
import ProductCategory from '../components/ProductCategory.astro';
import ProductOverview from '../components/ProductOverview.astro';
import RadSpunrie from '../components/RadSpunrie.astro';
import Hero from '../components/Hero.astro';
import HomeNews from '../components/HomeNews.astro';
import BusinessCards from '../components/BusinessCards.astro';
import BusinessProfile from '../components/BusinessProfile.astro';
import FoodCatalogue from '../components/FoodCatalogue.astro';
import CorporateContent from '../components/CorporateContent.astro';
import HeadquartersContact from '../components/HeadquartersContact.astro';
import News from '../components/News.astro';
import corporate from '../content/corporate.json';
import businesses from '../content/businesses.json';
import { locales,routeKeys,urlFor,pendingRoutes,type Locale,type RouteKey } from '../lib/routes';
import { t } from '../i18n/ui';
export function getStaticPaths(){return locales.flatMap(locale=>routeKeys.map(route=>({params:{path:urlFor(locale,route).slice(1,-1)||undefined},props:{locale,route}})));}
interface Props {locale:Locale;route:RouteKey;}
const {locale,route}=Astro.props;
const homeMeta={
  zh:{title:'深圳海川集团 | Oceanpower',description:'深圳海川集团新材料、食品、环境与信息技术业务网站预览。',products:'浏览新材料产品'},
  en:{title:'Shenzhen Oceanpower | Group website preview',description:'Shenzhen Oceanpower group overview: new materials, food, environment and information technology.',products:'Explore new materials products'},
  es:{title:'Oceanpower Shenzhen | Vista previa del grupo',description:'Presentación del grupo Oceanpower Shenzhen: nuevos materiales, alimentación, medio ambiente y tecnología de la información.',products:'Explorar productos de nuevos materiales'},
  fr:{title:'Oceanpower Shenzhen | Aperçu du groupe',description:'Présentation du groupe Oceanpower Shenzhen : nouveaux matériaux, alimentation, environnement et technologies de l’information.',products:'Découvrir les produits de nouveaux matériaux'},
}[locale];
const names:Record<string,string>={'':'Shenzhen Oceanpower','products/rad-spunrie':'Rad Spunrie asphalt modifier',products:'Products',about:'About',business:'Business','business/new-material':'New materials','business/food':'Food','business/environment':'Environment','business/information':'Information',news:'News',contact:'Contact'};
const corporatePage=route in corporate ? route as keyof typeof corporate : undefined;
const category=categories.find(item=>item.route===route);
const title=route==='' ? homeMeta.title : t(corporatePage ? corporate[corporatePage].title : category?.category || names[route],locale)+' | Oceanpower';
const pending=pendingRoutes.has(route);
const business=businesses.find(item=>route==='business/'+item.slug);
const description=(business ? t(business.summary,locale) : corporatePage ? t(corporate[corporatePage].intro,locale) : undefined) || (pending?t('This route follows the supplied website plan. Approved content has not yet been provided.',locale):homeMeta.description);
---
<BaseLayout locale={locale} route={route} title={title} description={description} noindex={pending}>
{route===''&&<><Hero locale={locale}/><BusinessCards locale={locale}/><HomeNews locale={locale}/><HeadquartersContact locale={locale}/></>}
{route==='products/rad-spunrie'&&<RadSpunrie locale={locale}/>}
{category&&<ProductCategory locale={locale} category={category}/>}
{route==='products'&&<ProductOverview locale={locale}/>}
{route==='about'&&<><CorporateContent page="about" locale={locale}/></>}
{(route==='research'||route==='careers'||route==='legal')&&<CorporateContent page={route} locale={locale}/>}
{route==='business'&&<BusinessCards locale={locale} standalone/>}
{business&&<BusinessProfile locale={locale} slug={business.slug}/>}
{route==='business/food'&&<FoodCatalogue locale={locale}/>}
{route==='business/new-material'&&<section class="section"><a class="button" href={urlFor(locale,'products')}>{homeMeta.products} →</a></section>}
{pending&&<section class="section pending-page"><p class="eyebrow dark">OCEANPOWER</p><h1>{t(names[route],locale)}</h1><h2>{t('Content awaiting review',locale)}</h2><p>{description}</p><a class="button" href={urlFor(locale,'business')}>{t('Business',locale)} →</a></section>}
{route==='contact'&&<><section class="section page-heading"><h1>{t('Contact',locale)}</h1></section><HeadquartersContact locale={locale}/></>}
{route==='news'&&<News locale={locale}/>}
</BaseLayout>
