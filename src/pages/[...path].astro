---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductComparison from '../components/ProductComparison.astro';
import Company from '../components/Company.astro';
import Applications from '../components/Applications.astro';
import BusinessCards from '../components/BusinessCards.astro';
import ContentSection from '../components/ContentSection.astro';
import { locales,routeKeys,urlFor,pendingRoutes,type Locale,type RouteKey } from '../lib/routes';
import { t } from '../i18n/ui';
export function getStaticPaths(){return locales.flatMap(locale=>routeKeys.map(route=>({params:{path:urlFor(locale,route).slice(1,-1)||undefined},props:{locale,route}})));}
interface Props {locale:Locale;route:RouteKey;}
const {locale,route}=Astro.props;
const names:Record<string,string>={'':'Oceanpower website demo',about:'About',business:'Business','business/new-material':'New materials','business/food':'Food','business/environment':'Environment','business/information':'Information',news:'News',contact:'Contact',demo:'LIVE DEMO MODE','products/gfrp':'GFRP Rebar','products/bfrp':'BFRP Rebar','products/cfrp':'CFRP Rebar'};
const title=t(names[route],locale)+' | Oceanpower';
const pending=pendingRoutes.has(route);
const description=pending?t('This route follows the supplied website plan. Approved content has not yet been provided.',locale):t('Advanced fiber-reinforced polymer reinforcement for the infrastructure that cannot afford corrosion, weight, or magnetic interference.',locale);
const product=route.startsWith('products/')?route.split('/')[1]:undefined;
---
<BaseLayout locale={locale} route={route} title={title} description={description} noindex={pending||route==='demo'} product={product?(product==='gfrp'?'GFRP sand-coated rebar':product.toUpperCase()+' rebar'):undefined}>
{route===''&&<><Hero locale={locale}/><ProductGrid locale={locale}/><ProductComparison locale={locale}/><Applications locale={locale}/><BusinessCards locale={locale}/><Company locale={locale}/><ContentSection selector="#sales-tools, #rfq, #contact" locale={locale}/></>}
{route==='about'&&<><section class="section page-heading"><p class="eyebrow dark">OCEANPOWER</p><h1>{t('About',locale)}</h1></section><Company locale={locale}/></>}
{route==='business'&&<><section class="section page-heading"><h1>{t('Business',locale)}</h1></section><BusinessCards locale={locale}/></>}
{route==='business/new-material'&&<><Hero locale={locale}/><ProductGrid locale={locale}/><ProductComparison locale={locale}/><Applications locale={locale}/><ContentSection selector="#rfq" locale={locale}/></>}
{pending&&<section class="section pending-page"><p class="eyebrow dark">OCEANPOWER</p><h1>{t(names[route],locale)}</h1><h2>{t('Content awaiting review',locale)}</h2><p>{description}</p><a class="button" href={urlFor(locale,'business')}>{t('Business',locale)} →</a></section>}
{route==='contact'&&<><section class="section page-heading"><h1>{t('Contact',locale)}</h1></section><ContentSection selector="#rfq, #contact" locale={locale}/></>}
{product&&<div class="product-detail"><ContentSection page={product as 'gfrp'|'bfrp'|'cfrp'} selector=".product-wrap" locale={locale}/></div>}
{route==='demo'&&<><section class="section page-heading"><h1>{t('LIVE DEMO MODE',locale)}</h1></section><ContentSection page="demo" selector="#demo-mode" locale={locale}/></>}
</BaseLayout>
