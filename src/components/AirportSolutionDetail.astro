---
import {urlFor,type Locale} from '../lib/routes';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const rows=locale==='zh'?[
  ['混合料稳定与纤维加筋','AM-400','混合料类型、纤维分散、试验掺量'],
  ['高温车辙及推移控制','AM-500','荷载、气候、级配、油石比及施工温度'],
  ['高黏、黏结、抗疲劳及水稳定','AM-600','基质沥青、目标黏度、SMA 配合比'],
  ['动态模量及结构抗变形','AM-800','目标模量、结构层厚度及材料加热温度'],
  ['降温施工及和易性','AM-110 / 120 / 130','拌合站投料方式、基质沥青及目标温度'],
]:[
  ['Mixture stabilisation and fibre reinforcement','AM-400','Mixture type, fibre dispersion and trial dosage'],
  ['High-temperature rutting and shoving control','AM-500','Loading, climate, gradation, binder ratio and temperatures'],
  ['Viscosity, adhesion, fatigue and water stability','AM-600','Base binder, target viscosity and SMA mix design'],
  ['Dynamic modulus and deformation resistance','AM-800','Target modulus, layer structure and heating temperatures'],
  ['Lower-temperature construction and workability','AM-110 / 120 / 130','Plant dosing route, base binder and target temperatures'],
];
const requirements=locale==='zh'?['机场功能区及主要病害或性能目标','新建或既有道面、结构层及混合料级配','基质沥青、现有配合比及目标指标','当地气候、施工季节及温度条件','施工窗口、拌合站设备及运输距离','适用标准、试验计划及审批责任人']:['Airport zone and the primary distress or performance target','New or existing pavement, structural layer and mixture gradation','Base binder, current mix design and target values','Climate, construction season and temperature conditions','Work window, plant equipment and haul distance','Applicable standards, testing plan and approval owner'];
---
<section class="airport-detail" aria-labelledby="airport-selection-title">
  <header><p class="eyebrow dark"><i></i> {locale==='zh'?'项目选型路径':'PROJECT SELECTION PATH'}</p><h2 id="airport-selection-title">{locale==='zh'?'从工程问题出发，不从产品名称出发。':'Start with the pavement requirement.'}</h2><p>{locale==='zh'?'以下对照表用于形成初步技术沟通范围。一个项目可能涉及多个性能目标，但产品不能仅凭本页自动组合。':'Use this matrix to frame an initial technical discussion. A project may have several performance targets, but the products must not be combined automatically from this page.'}</p></header>
  <p class="selection-scroll-note" id="airport-selection-scroll">{locale==='zh'?'小屏幕可左右滑动查看完整选型表。':'On smaller screens, swipe sideways to read the full selection table.'}</p>
  <div class="selection-table-wrap" tabindex="0" role="region" aria-label={locale==='zh'?'机场道面材料初步选型表':'Preliminary airport pavement material selection table'} aria-describedby="airport-selection-scroll"><table><thead><tr><th>{locale==='zh'?'工程目标':'Project requirement'}</th><th>{locale==='zh'?'初步产品系列':'Initial family'}</th><th>{locale==='zh'?'项目需确认':'Confirm for the project'}</th></tr></thead><tbody>{rows.map(row=><tr>{row.map((cell,index)=>index===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div>
  <div class="airport-review-grid"><section><span>01</span><h3>{locale==='zh'?'准备项目资料':'Prepare the project brief'}</h3><ol>{requirements.map(item=><li>{item}</li>)}</ol></section><section><span>02</span><h3>{locale==='zh'?'建议审核流程':'Suggested review sequence'}</h3><ol><li>{locale==='zh'?'确认病害、结构层及性能目标':'Confirm distress, layer and performance target'}</li><li>{locale==='zh'?'筛选一个或多个候选产品系列':'Shortlist one or more candidate families'}</li><li>{locale==='zh'?'完成室内配合比、性能及施工适应性试验':'Complete laboratory mix, performance and constructability tests'}</li><li>{locale==='zh'?'由项目工程师及机场相关责任方审核':'Obtain review from project engineers and responsible airport parties'}</li></ol></section></div>
  <aside class="airport-enquiry"><div><p class="eyebrow"><i></i> {locale==='zh'?'供工作人员审核':'FOR STAFF REVIEW'}</p><h3>{locale==='zh'?'已有机场项目资料？':'Have an airport pavement brief?'}</h3><p>{locale==='zh'?'请向技术团队提供应用场景、候选产品、结构层、数量、地点及期望时间，由工作人员确认材料选择与商务条件。':'Share the application, candidate product, pavement layer, quantity, location and requested timeframe with the technical team. Staff will confirm material selection and commercial terms.'}</p></div><div><a href={urlFor(locale,'contact')}>{locale==='zh'?'联系技术团队':'Contact the technical team'} <span aria-hidden="true">→</span></a></div></aside>
</section>
<style>
.airport-detail{margin-top:clamp(64px,8vw,112px);border-top:4px solid var(--ink);padding-top:clamp(36px,5vw,64px)}.airport-detail>header{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:24px 70px;align-items:end}.airport-detail>header .eyebrow{grid-column:1/-1}.airport-detail h2{font-size:clamp(34px,4.8vw,64px);line-height:1.05;letter-spacing:-2px;margin:0}.airport-detail>header>p:last-child{line-height:1.8;color:#455c73;margin:0;max-width:60ch}.selection-scroll-note{font:500 12px/1.6 'DM Mono',monospace;color:#52677b;margin:34px 0 10px}.selection-table-wrap{overflow-x:auto;border:1px solid var(--line);background:#fff}.selection-table-wrap:focus-visible{outline:3px solid var(--blue);outline-offset:4px}.selection-table-wrap table{border-collapse:collapse;width:100%;min-width:760px}.selection-table-wrap th,.selection-table-wrap td{text-align:left;padding:18px 20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);line-height:1.55}.selection-table-wrap thead th{background:var(--ink);color:#f5f8f7;font:500 12px 'DM Mono',monospace;letter-spacing:.04em}.selection-table-wrap tbody th{width:34%;font-size:15px}.selection-table-wrap tbody td:nth-child(2){font-weight:800;color:var(--blue);white-space:nowrap}.airport-review-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;margin-top:32px}.airport-review-grid>section{border-top:3px solid var(--aqua);background:#eef3f1;padding:30px}.airport-review-grid span{font:500 13px 'DM Mono',monospace;color:var(--blue)}.airport-review-grid h3{font-size:clamp(23px,2.6vw,32px);margin:14px 0 20px}.airport-review-grid ol{margin:0;padding-left:22px;display:grid;gap:12px}.airport-review-grid li{line-height:1.65;padding-left:6px}.airport-enquiry{margin-top:32px;padding:clamp(28px,4vw,48px);background:var(--ink);color:#f5f8f7;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:48px;align-items:end}.airport-enquiry h3{font-size:clamp(26px,3vw,40px);margin:12px 0}.airport-enquiry p:not(.eyebrow){line-height:1.75;color:#c9d7de;margin:0;max-width:72ch}.airport-enquiry>div:last-child{display:grid;gap:12px;min-width:220px}.airport-enquiry button,.airport-enquiry a{min-height:46px;display:flex;align-items:center;justify-content:center;padding:0 18px;font-weight:800}.airport-enquiry button{border:1px solid var(--aqua);background:var(--aqua);color:var(--ink);cursor:pointer}.airport-enquiry a{border:1px solid #6f8795;color:#f5f8f7}.airport-enquiry button:focus-visible,.airport-enquiry a:focus-visible{outline:3px solid var(--aqua);outline-offset:4px}@media(max-width:800px){.airport-detail>header,.airport-review-grid,.airport-enquiry{grid-template-columns:1fr}.airport-detail>header{gap:24px}.airport-enquiry{gap:28px}.airport-enquiry>div:last-child{min-width:0}}@media(max-width:520px){.airport-review-grid>section{padding:24px 18px}.airport-enquiry{padding-inline:20px}.airport-detail h2{letter-spacing:-1.2px}}
</style>
