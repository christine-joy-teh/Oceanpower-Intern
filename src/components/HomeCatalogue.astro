---
import {categoryPortfolios,local} from '../content/catalogue';
import {urlFor,type Locale} from '../lib/routes';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const families=[
  {route:'products/fibre-reinforced-composites',index:'01',image:'/assets/product-example-186.jpg',alt:{en:'Fibre-reinforced composite products',zh:'纤维增强复合材料产品'},label:{en:'Fibre-reinforced composites',zh:'纤维增强复合材料'},count:{en:'4 distinct catalogue product families',zh:'4 个独立目录产品系列'}},
  {route:'products/asphalt-based-products',index:'02',image:'/assets/product-example-191.jpg',alt:{en:'Asphalt pavement material',zh:'道路沥青材料'},label:{en:'Asphalt pavement materials',zh:'道路沥青材料'},count:{en:'6 modifier and pavement systems',zh:'6 个改性剂及路面材料体系'}},
  {route:'products/integrated-solutions',index:'03',image:'/assets/oceanpower-cover.jpg',alt:{en:'Integrated infrastructure material application',zh:'基础设施综合材料应用'},label:{en:'Airport pavement materials',zh:'机场道面专用材料'},count:{en:'5 dedicated airport-asphalt product groups',zh:'5 类机场沥青道面专用产品'}},
] as const;
---
<section class="home-catalogue section" id="product-families" aria-labelledby="product-families-title">
  <header class="catalogue-heading"><div><p class="eyebrow dark"><i></i> {locale==='zh'?'产品导航':'PRODUCT DIRECTORY'}</p><h2 id="product-families-title">{locale==='zh'?'先选材料体系，再核对具体产品。':'Start with the material system.'}</h2></div><p>{locale==='zh'?'首页按最新版资料重新整理产品入口。每个技术参数均与对应产品及来源保持关联，避免不同产品之间误用数据。':'The product entry points now follow the latest supplied manuals. Technical values remain attached to the relevant product and source to reduce cross-product confusion.'}</p></header>
  <div class="family-grid">
    {families.map((family,index)=>{const portfolio=categoryPortfolios[family.route];return <article class:list={['family-card',index===0&&'family-card-primary']}>
      <a class="family-image" href={urlFor(locale,family.route)} aria-label={`${local(family.label,locale)} — ${locale==='zh'?'查看产品':'view products'}`}><img src={family.image} alt={local(family.alt,locale)} width="900" height="620" loading={index===0?'eager':'lazy'}/><span>{family.index}</span></a>
      <div class="family-copy"><p>{local(family.count,locale)}</p><h3>{local(family.label,locale)}</h3><p class="family-summary">{local(portfolio.intro,locale)}</p><a href={urlFor(locale,family.route)}>{locale==='zh'?'查看产品与参数':'View products and data'} <span aria-hidden="true">→</span></a></div>
    </article>})}
  </div>
  <div class="selection-notes" aria-label={locale==='zh'?'网站资料说明':'Website information guide'}>
    <div><strong>01</strong><span>{locale==='zh'?'产品分开列示':'Products kept distinct'}</span><p>{locale==='zh'?'GFRP 筋材、锚杆及其他产品不共用参数。':'Rebar, anchor bars and other products do not share specifications.'}</p></div>
    <div><strong>02</strong><span>{locale==='zh'?'显示目录来源':'Catalogue sources shown'}</span><p>{locale==='zh'?'产品页面保留对应手册及印刷页码。':'Product pages retain the relevant manual and printed-page reference.'}</p></div>
    <div><strong>03</strong><span>{locale==='zh'?'项目资料需人工确认':'Project details need review'}</span><p>{locale==='zh'?'价格、供货期和工程适用性由工作人员确认。':'Staff confirm pricing, lead time and engineering suitability.'}</p></div>
  </div>
</section>
<style>
.home-catalogue{padding-block:clamp(64px,8vw,112px)}.catalogue-heading{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:clamp(36px,7vw,100px);align-items:end;margin-bottom:44px}.catalogue-heading h2{font-size:clamp(36px,5vw,68px);line-height:1.03;letter-spacing:-2.4px;margin:12px 0 0;max-width:800px}.catalogue-heading>p{font-size:17px;line-height:1.8;margin:0;max-width:58ch;color:#455c73}.family-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);grid-template-rows:repeat(2,minmax(0,1fr));gap:24px}.family-card{border:1px solid var(--line);background:#fbfdfc;display:grid;grid-template-columns:minmax(150px,.72fr) minmax(0,1.28fr);min-width:0}.family-card-primary{grid-row:1/3;display:flex;flex-direction:column}.family-image{position:relative;display:block;min-height:240px;overflow:hidden;background:#e9efee}.family-card-primary .family-image{min-height:420px}.family-image img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;transition:transform .45s cubic-bezier(.16,1,.3,1)}.family-image>span{position:absolute;left:18px;top:18px;width:46px;height:46px;display:grid;place-items:center;background:var(--ink);color:var(--aqua);font:500 14px 'DM Mono',monospace}.family-copy{padding:clamp(22px,3vw,36px);display:flex;flex-direction:column;min-width:0}.family-copy>p:first-child{font:500 11px/1.5 'DM Mono',monospace;letter-spacing:.05em;color:#52677b;margin:0 0 12px}.family-copy h3{font-size:clamp(24px,3vw,38px);line-height:1.12;letter-spacing:-1px;margin:0 0 15px}.family-summary{font-size:14px;line-height:1.7;color:#455c73;margin:0 0 24px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.family-copy>a{margin-top:auto;display:flex;align-items:center;min-height:44px;color:var(--blue);font-weight:800}.family-copy>a:focus-visible,.family-image:focus-visible{outline:3px solid var(--blue);outline-offset:4px}.selection-notes{display:grid;grid-template-columns:1.15fr 1fr 1fr;margin-top:32px;border-top:2px solid var(--ink);border-bottom:1px solid var(--line)}.selection-notes>div{padding:26px 28px;border-right:1px solid var(--line)}.selection-notes>div:last-child{border-right:0}.selection-notes strong{font:500 13px 'DM Mono',monospace;color:var(--blue);display:block;margin-bottom:18px}.selection-notes span{font-weight:800;font-size:17px}.selection-notes p{font-size:13px;line-height:1.65;color:#52677b;margin:10px 0 0;max-width:36ch}@media(hover:hover){.family-image:hover img{transform:scale(1.025)}}@media(max-width:950px){.family-grid{grid-template-columns:1fr;grid-template-rows:auto}.family-card-primary{grid-row:auto}.family-card-primary .family-image{min-height:360px}.selection-notes{grid-template-columns:1fr 1fr}.selection-notes>div:nth-child(2){border-right:0}.selection-notes>div:last-child{grid-column:1/-1;border-top:1px solid var(--line)}}@media(max-width:700px){.catalogue-heading{grid-template-columns:1fr;gap:24px}.catalogue-heading h2{letter-spacing:-1.5px}.family-card{grid-template-columns:1fr}.family-image,.family-card-primary .family-image{min-height:260px}.selection-notes{grid-template-columns:1fr}.selection-notes>div{border-right:0;border-bottom:1px solid var(--line);padding-inline:4px}.selection-notes>div:last-child{grid-column:auto;border-bottom:0}.family-summary{-webkit-line-clamp:5}}@media(prefers-reduced-motion:reduce){.family-image img{transition:none}.family-image:hover img{transform:none}}
</style>
