---
import { locales, languageNames, urlFor, type Locale } from '../lib/routes';
import { t } from '../i18n/ui';
interface Props { locale: Locale; route: string; }
const {locale,route}=Astro.props;
---
<details class="language-menu"><summary aria-label={t('Language',locale)}>{languageNames[locale]}</summary><div>{locales.map(lang=><a href={urlFor(lang,route)} lang={lang} hreflang={lang} aria-current={lang===locale?'page':undefined}>{languageNames[lang]}</a>)}</div></details>
