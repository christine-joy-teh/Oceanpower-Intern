---
import type { Locale } from '../lib/routes';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const zh=locale==='zh';
const copy=(en:string,cn:string)=>zh?cn:en;
const powders=[
  {name:'Colorful Snow / 七彩雪',flavors:'Pineapple, strawberry, cantaloupe, blueberry, apple, chocolate, vanilla, taro and original',flavorsZh:'菠萝、草莓、哈密瓜、蓝莓、苹果、巧克力、香草、芋头、原味',page:3},
  {name:'ICE KING / 酷冰王',flavors:'Strawberry, chocolate and vanilla',flavorsZh:'草莓、巧克力、香草',page:3},
  {name:'Gelinao Silver / 格林奥银标',flavors:'Strawberry, original, chocolate, vanilla and blueberry sea salt',flavorsZh:'草莓、原味、巧克力、香草、海盐蓝莓',page:3},
  {name:'Gelinao Gold / 格林奥金标',flavors:'Strawberry, matcha, vanilla and chocolate',flavorsZh:'草莓、抹茶、香草、巧克力',page:4},
  {name:'Oceanpower Premium / 海川高端特级',flavors:'Original, matcha and chocolate',flavorsZh:'原味、抹茶、巧克力',page:4},
];
const machines=[
  {model:'NE2430L',type:'Dual-control soft serve',typeZh:'双控软冰淇淋机',output:'65 L/h',mix:'2 × 12 L',power:'4,400 W',page:12},
  {model:'NE1115EL',type:'Single-flavour soft serve',typeZh:'单口味软冰淇淋机',output:'30 L/h',mix:'8 L',power:'1,900 W',page:14},
  {model:'NE1112',type:'Single-flavour soft serve',typeZh:'单口味软冰淇淋机',output:'30 L/h',mix:'1.2 L',power:'1,900 W',page:14},
  {model:'DW132ETC',type:'Twin-twist soft serve',typeZh:'双口味混合软冰淇淋机',output:'40 L/h',mix:'2 × 12 L',power:'2,800 W',page:16},
  {model:'DW138ETC',type:'Twin-twist soft serve',typeZh:'双口味混合软冰淇淋机',output:'40 L/h',mix:'2 × 12 L',power:'2,800 W',page:16},
  {model:'OP130',type:'Twin-twist soft serve',typeZh:'双口味混合软冰淇淋机',output:'30 L/h',mix:'2 × 6.5 L',power:'2,000 W',page:18},
  {model:'OP132BA',type:'Twin-twist soft serve',typeZh:'双口味混合软冰淇淋机',output:'32 L/h',mix:'2 × 6.5 L',power:'2,500 W',page:18},
];
---
<section class="food-catalogue section" id="food-products" aria-labelledby="food-products-title" lang={locale==='es'||locale==='fr'?'en':undefined}>
  {(locale==='es'||locale==='fr')&&<p class="food-language-note" lang={locale}>{locale==='es'?'Los detalles de este catálogo están disponibles en inglés y chino.':'Les détails de ce catalogue sont disponibles en anglais et en chinois.'}</p>}
  <header class="food-heading">
    <div><p class="eyebrow dark">{copy('FOOD PRODUCT GUIDE','食品产品目录')}</p><h2 id="food-products-title">{copy('From the machine to the finished serve.','从设备、原料到成品。')}</h2></div>
    <p>{copy('The supplied catalogue covers soft-serve and gelato equipment, ice cream powders, wafer cones and serving accessories. Product information below is linked to the PDF page where it appears.','这份目录涵盖软冰淇淋及意式冰淇淋设备、冰淇淋粉、威化甜筒与配套用品。以下资料标明对应的 PDF 页码，便于核对。')}</p>
  </header>

  <nav class="food-nav" aria-label={copy('Food product groups','食品产品分组')}>
    <a href="#food-machines"><img src="/assets/food-catalogue/ice-cream-equipment.webp" alt={copy('Soft-serve and gelato machines pictured in the catalogue','目录中的软冰淇淋机与意式冰淇淋机')} width="960" height="650" loading="lazy"/><span><small>01 / {copy('EQUIPMENT','设备')}</small><strong>{copy('Ice cream machines','冰淇淋设备')}</strong><b aria-hidden="true">↗</b></span></a>
    <a href="#food-powders"><img src="/assets/food-catalogue/flavour-powders.webp" alt={copy('Soft-serve flavours shown with the powder range','冰淇淋粉系列展示的软冰淇淋口味')} width="1080" height="790" loading="lazy"/><span><small>02 / {copy('INGREDIENTS','原料')}</small><strong>{copy('Powders and premixes','冰淇淋粉与预拌粉')}</strong><b aria-hidden="true">↗</b></span></a>
    <a href="#food-cones"><img src="/assets/food-catalogue/wafer-cone.webp" alt={copy('Oceanpower wafer cone pictured in the catalogue','目录中的海川威化甜筒')} width="1060" height="840" loading="lazy"/><span><small>03 / {copy('SERVING','出品')}</small><strong>{copy('Cones and accessories','甜筒与配套用品')}</strong><b aria-hidden="true">↗</b></span></a>
  </nav>

  <div class="food-source-note"><strong>{copy('Catalogue reference','目录资料')}</strong><p>{copy('Specifications are reproduced from the supplied 28-page product catalogue. Model options, availability, certifications and current specifications need confirmation by the food division before use in a quotation.','以下参数摘自提供的 28 页产品目录。用于报价前，机型选配、供货情况、认证及现行规格须由食品业务人员确认。')}</p></div>

  <section class="food-block" id="food-machines" aria-labelledby="food-machines-title">
    <div class="food-block-heading"><p>01 / {copy('EQUIPMENT','设备')}</p><h3 id="food-machines-title">{copy('Soft-serve machines','软冰淇淋机')}</h3><span>{copy('Output, hopper volume and rated power are kept with their exact model.','产量、储料缸容量与功率均对应具体机型。')}</span></div>
    <p class="table-scroll-note">{copy('Swipe the table to see all specifications.','左右滑动表格查看完整参数。')}</p>
    <div class="machine-table-wrap" role="region" tabindex="0" aria-label={copy('Soft-serve machine specifications','软冰淇淋机参数表')}><table class="machine-table"><thead><tr><th scope="col">{copy('Model','机型')}</th><th scope="col">{copy('Type','类型')}</th><th scope="col">{copy('Catalogue output','目录产量')}</th><th scope="col">{copy('Mix hopper','储料缸')}</th><th scope="col">{copy('Power','功率')}</th><th scope="col">{copy('Source','来源')}</th></tr></thead><tbody>{machines.map(machine=><tr><th scope="row">{machine.model}</th><td>{zh?machine.typeZh:machine.type}</td><td>{machine.output}</td><td>{machine.mix}</td><td>{machine.power}</td><td>{copy(`PDF p. ${machine.page}`,`PDF 第 ${machine.page} 页`)}</td></tr>)}</tbody></table></div>
    <div class="food-additional">
      <article><img src="/assets/food-catalogue/gelato-machine.webp" alt={copy('Gelato batch freezer from the catalogue','目录中的意式冰淇淋凝冻机')} width="700" height="820" loading="lazy"/><div><strong>{copy('Gelato and hard ice cream','意式及硬冰淇淋')}</strong><p>{copy('The catalogue also presents OPH42 and OPH76 vertical gelato batch freezers. Their production figures are printed without a time basis, so this page does not interpret them as hourly output.','目录另列有 OPH42 与 OPH76 立式意式冰淇淋凝冻机。原表的产量数值未标明时间单位，本页不将其解读为每小时产量。')}</p><small>{copy('PDF pp. 23–24','PDF 第 23–24 页')}</small></div></article>
      <article><div><strong>{copy('Other equipment','其他设备')}</strong><p>{copy('The range also includes the OP725 four-hopper machine, SUNNYA18 compact single-flavour model and OPA61 pasteurizer. The OPA61 table lists a 61 L tank and 3-hour batch time. Confirm the OP725 and SUNNYA18 production figures with staff before quoting.','系列另有 OP725 四储料缸机、SUNNYA18 小型单口味机及 OPA61 巴氏杀菌机。OPA61 参数表列有 61 L 料缸和 3 小时批次时间；OP725 与 SUNNYA18 的产量数据用于报价前须由工作人员核实。')}</p><small>{copy('PDF pp. 20, 22, 26','PDF 第 20、22、26 页')}</small></div></article>
    </div>
  </section>

  <section class="food-block" id="food-powders" aria-labelledby="food-powders-title">
    <div class="food-block-heading"><p>02 / {copy('INGREDIENTS','原料')}</p><h3 id="food-powders-title">{copy('Ice cream powders and premixes','冰淇淋粉与预拌粉')}</h3><span>{copy('The five soft-serve lines below each list 1 kg × 12 bags per box and a 12-month shelf life in the catalogue.','以下五个软冰淇淋粉系列在目录中均标为每箱 1 kg × 12 袋，保质期 12 个月。')}</span></div>
    <div class="powder-list">{powders.map(powder=><article><div><h4>{powder.name}</h4><p>{zh?powder.flavorsZh:powder.flavors}</p></div><span>{copy(`PDF p. ${powder.page}`,`PDF 第 ${powder.page} 页`)}</span></article>)}</div>
    <div class="food-specialty"><article><h4>{copy('Frozen-yogurt powder','酸奶冰淇淋粉')}</h4><p>{copy('Original flavour; 1 kg × 12 bags per box; 12-month shelf life.','原味；每箱 1 kg × 12 袋；保质期 12 个月。')}</p><small>{copy('PDF p. 4','PDF 第 4 页')}</small></article><article><h4>{copy('Hard ice cream powder','硬冰淇淋粉')}</h4><p>{copy('The listed flavours include original, vanilla, strawberry, mango, chocolate, apple, cantaloupe, pineapple and taro. The catalogue lists 1 kg × 12 bags per box and a 12-month shelf life.','目录列有原味、香草、草莓、芒果、巧克力、苹果、哈密瓜、菠萝及香芋口味；每箱 1 kg × 12 袋，保质期 12 个月。')}</p><small>{copy('PDF p. 4','PDF 第 4 页')}</small></article></div>
    <p class="food-related">{copy('Cone premixes, beverage powders and toppings are listed separately on PDF pp. 6–7.','脆筒预拌粉、固体饮料粉与配料另见 PDF 第 6–7 页。')}</p>
  </section>

  <section class="food-block" id="food-cones" aria-labelledby="food-cones-title">
    <div class="food-block-heading"><p>03 / {copy('SERVING','出品')}</p><h3 id="food-cones-title">{copy('Wafer cones and accessories','威化甜筒与配套用品')}</h3><span>{copy('Several cone shapes and a wafer-cone biscuit are shown; dimensions vary by design.','目录展示多种甜筒造型及威化饼干筒，各款尺寸不同。')}</span></div>
    <div class="cone-facts"><div><strong>{copy('Wafer-cone biscuit','威化饼干筒')}</strong><p>{copy('60 mm opening; catalogue pack sizes of 600 or 1,200 pieces per box.','口径 60 mm；目录列出每箱 600 个或 1,200 个两种包装。')}</p><small>{copy('PDF p. 8','PDF 第 8 页')}</small></div><div><strong>{copy('Cone shapes','甜筒造型')}</strong><p>{copy('The range includes original, sesame, oxhorn, bamboo-charcoal and two-colour styles. Match size and packaging to the selected style.','系列包含原味、芝麻、牛角、竹炭及双色等造型。尺寸与包装需按具体款式核对。')}</p><small>{copy('PDF p. 9','PDF 第 9 页')}</small></div><div><strong>{copy('Serving accessories','出品配件')}</strong><p>{copy('The catalogue also shows cone holders, dispensers and decorative caps.','目录另展示甜筒架、甜筒分配器及装饰帽。')}</p><small>{copy('PDF p. 26','PDF 第 26 页')}</small></div></div>
  </section>
</section>
<style>
.food-specialty{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:24px}.food-specialty article{padding:24px;background:#eaf0ef}.food-specialty h4{font-size:19px;margin:0}.food-specialty p{font-size:14px;line-height:1.7;color:#455c73}.food-specialty small{font:500 11px 'DM Mono',monospace;color:#52677b}@media(max-width:620px){.food-specialty{grid-template-columns:1fr}}
.food-language-note{padding:14px 18px;background:#eaf0ef;border-top:2px solid var(--blue);font-size:14px;line-height:1.5;margin:0 0 28px}
.table-scroll-note{display:none}.machine-table-wrap:focus-visible{outline:3px solid var(--blue);outline-offset:3px}@media(max-width:740px){.table-scroll-note{display:block;color:#52677b;font-size:13px;margin:0 0 10px}}
.food-catalogue{padding-block:clamp(64px,8vw,112px);border-top:1px solid var(--line)}.food-heading{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:clamp(32px,5vw,80px);align-items:end;margin-bottom:40px}.food-heading h2{font-size:clamp(34px,4.7vw,64px);line-height:1.05;letter-spacing:-.035em;max-width:15ch;margin:12px 0 0}.food-heading>p{font-size:17px;line-height:1.7;color:#455c73;max-width:58ch;margin:0}.food-nav{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:16px}.food-nav a{display:grid;grid-template-rows:220px auto;background:#fff;border:1px solid var(--line);color:var(--ink);text-decoration:none;min-width:0}.food-nav img{width:100%;height:220px;object-fit:cover;object-position:center;background:#dcecf0}.food-nav a:nth-child(2) img{object-position:center 30%}.food-nav a:nth-child(3) img{object-position:center}.food-nav a>span{display:grid;grid-template-columns:1fr auto;gap:10px;padding:20px;min-height:112px;align-items:end}.food-nav small{grid-column:1/-1;font:500 11px 'DM Mono',monospace;color:#52677b;letter-spacing:.06em}.food-nav strong{font-size:clamp(19px,2vw,27px);line-height:1.2}.food-nav b{color:var(--blue);font-size:20px}.food-nav a:hover,.food-nav a:focus-visible{border-color:var(--blue);outline:2px solid var(--blue);outline-offset:2px}.food-source-note{display:grid;grid-template-columns:170px 1fr;gap:24px;padding:22px 0;margin:32px 0 72px;border-block:1px solid var(--line)}.food-source-note strong{font:500 12px 'DM Mono',monospace;color:var(--blue)}.food-source-note p{margin:0;line-height:1.7;color:#455c73}.food-block{scroll-margin-top:110px;margin-top:72px}.food-block-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:12px 40px;align-items:end;border-bottom:2px solid var(--ink);padding-bottom:20px;margin-bottom:24px}.food-block-heading>p{grid-column:1/-1;margin:0;font:500 12px 'DM Mono',monospace;color:var(--blue)}.food-block-heading h3{font-size:clamp(30px,3.6vw,48px);line-height:1.1;letter-spacing:-.025em;margin:0}.food-block-heading span{line-height:1.65;color:#455c73}.machine-table-wrap{overflow-x:auto}.machine-table{border-collapse:collapse;width:100%;min-width:730px;text-align:left}.machine-table th,.machine-table td{padding:17px 14px;border-bottom:1px solid var(--line);vertical-align:top;font-size:14px;line-height:1.45}.machine-table thead th{font:500 11px 'DM Mono',monospace;letter-spacing:.04em;color:#455c73;background:#eaf0ef}.machine-table tbody th{font:700 15px Manrope,sans-serif;color:var(--ink)}.machine-table tbody td:last-child{white-space:nowrap;color:#52677b;font-size:12px}.food-additional{display:grid;grid-template-columns:1.3fr 1fr;gap:16px;margin-top:24px}.food-additional article{display:grid;grid-template-columns:140px 1fr;gap:18px;align-items:center;padding:20px;background:#eaf0ef;min-width:0}.food-additional article:last-child{grid-template-columns:1fr;background:#f3f1e9}.food-additional img{width:100%;height:180px;object-fit:cover;object-position:center}.food-additional strong,.cone-facts strong{font-size:19px}.food-additional p,.cone-facts p{font-size:14px;line-height:1.7;margin:10px 0;color:#455c73}.food-additional small,.cone-facts small,.powder-list span{font:500 11px 'DM Mono',monospace;color:#52677b}.powder-list{border-top:1px solid var(--line)}.powder-list article{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;padding:20px 0;border-bottom:1px solid var(--line)}.powder-list h4{font-size:19px;margin:0 0 7px}.powder-list p{margin:0;color:#455c73;line-height:1.6}.powder-list span{white-space:nowrap}.food-related{max-width:75ch;line-height:1.75;margin:22px 0 0;color:#455c73}.cone-facts{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:0;border:1px solid var(--line)}.cone-facts>div{padding:24px;border-right:1px solid var(--line)}.cone-facts>div:last-child{border-right:0}@media(max-width:900px){.food-heading,.food-block-heading{grid-template-columns:1fr}.food-nav{grid-template-columns:1fr 1fr}.food-nav a:first-child{grid-column:1/-1;grid-template-columns:1fr 1fr;grid-template-rows:auto}.food-nav a:first-child img{height:100%;min-height:220px}.food-additional{grid-template-columns:1fr}.cone-facts{grid-template-columns:1fr 1fr}.cone-facts>div:nth-child(2){border-right:0}.cone-facts>div:last-child{border-top:1px solid var(--line)}}@media(max-width:620px){.food-nav{grid-template-columns:1fr}.food-nav a:first-child{grid-column:auto;grid-template-columns:1fr;grid-template-rows:220px auto}.food-nav a:first-child img{min-height:0;height:220px}.food-source-note{grid-template-columns:1fr;gap:8px;margin-bottom:54px}.food-block{margin-top:56px}.food-block-heading{gap:12px}.food-additional article{grid-template-columns:100px 1fr;padding:16px}.food-additional img{height:150px}.powder-list article{grid-template-columns:1fr;gap:8px}.cone-facts{grid-template-columns:1fr}.cone-facts>div{border-right:0;border-bottom:1px solid var(--line)}.cone-facts>div:last-child{border-bottom:0;border-top:0}}
</style>
