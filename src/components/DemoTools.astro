---
import { load } from 'cheerio';
import { fragment } from '../lib/content';
import { t, clientDictionary } from '../i18n/ui';
import { urlFor, type Locale } from '../lib/routes';
interface Props {locale:Locale;product?:string;}
const {locale,product=''}=Astro.props;
const fields=[['application','Application / project use','text'],['product','Product','text'],['dimensions','Diameter / dimensions','text'],['quantity','Quantity and unit','text'],['destination','Delivery country or port','text'],['delivery','Preferred delivery date','text'],['name','Your name','text'],['contact','Business email','email'],['company','Company (optional)','text']];
const dictionary={...clientDictionary(locale),products:Object.fromEntries((['gfrp','bfrp','cfrp'] as const).map(id=>{const $=load(fragment(id,'#product-specs',locale));return[id,{text:$('table tr').toArray().map(row=>$(row).find('th,td').toArray().map(cell=>$(cell).text()).join(' · ')).join('\n')+'\n'+$('.product-source').text(),href:urlFor(locale,'products/'+id)}];}))};
---
<button class="chat-launcher" type="button" data-open-catalogue aria-controls="catalogue-dialog"><span class="chat-spark">?</span><span>{t('AI assistant',locale)}</span></button>
<dialog id="enquiry-dialog" class="chat-panel enquiry-dialog" aria-labelledby="enquiry-heading" data-product={product}><div class="chat-header"><b id="enquiry-heading">{t('Enquiry draft',locale)}</b><button class="chat-close" type="button" data-dialog-close aria-label={t('Close',locale)}>×</button></div><div class="chat-workspace"><div class="rfq-content"><p>{t('Use fictional details. This draft stays in this page and is cleared when you leave or reload. No enquiry is sent.',locale)}</p><form id="enquiry-form"><p>{t('All fields are required unless marked optional; you may mark project details as not sure yet.',locale)}</p><div class="rfq-fields"><fieldset><legend>{t('Project requirements',locale)}</legend>{fields.map(([id,label,type],index)=><div class="rfq-field" data-field={id}><label for={'rfq-'+id}>{t(label,locale)}</label><div class="rfq-field-controls"><input id={'rfq-'+id} name={id} type={type as "text" | "email"} maxlength="240" required={id!=='company'} value={id==='product'?product:''} autocomplete={id==='name'?'name':id==='contact'?'email':id==='company'?'organization':'off'}/>{index<6&&<button class="rfq-unknown" type="button" data-unknown={id} aria-pressed="false">{t('Not sure yet',locale)}</button>}</div></div>)}</fieldset></div><button class="button" type="submit">{t('Review enquiry',locale)}</button></form><section id="enquiry-review" class="rfq-review" hidden tabindex="-1"><h3>{t('Review enquiry',locale)}</h3><dl></dl><div class="rfq-actions"><button type="button" data-edit>{t('Edit details',locale)}</button><button type="button" data-copy>{t('Copy enquiry',locale)}</button><button type="button" data-complete>{t('Complete demo',locale)}</button></div><textarea class="rfq-copy-manual" hidden readonly aria-label={t('Copy enquiry',locale)}></textarea></section><p id="enquiry-status" role="status" tabindex="-1"></p></div></div></dialog>
<dialog id="catalogue-dialog" class="chat-panel catalogue-dialog" aria-labelledby="catalogue-heading"><div class="chat-header"><div><b id="catalogue-heading">{t('AI assistant',locale)}</b><small id="chat-mode" role="status">{t('Checking assistant connection…',locale)}</small></div><button type="button" class="chat-close" data-dialog-close aria-label={t('Close',locale)}>×</button></div><div class="chat-workspace"><div class="chat-stream" role="log" aria-live="polite"><p class="bot-message">{t('Ask about Oceanpower products or your project requirements. Technical answers require engineering review.',locale)}</p></div><div class="quick-replies">{['gfrp','bfrp','cfrp'].map(id=><a href={urlFor(locale,'products/'+id)}>{id.toUpperCase()}</a>)}</div><form id="catalogue-form" class="chat-form"><label class="sr-only" for="catalogue-question">{t('Your project question',locale)}</label><input id="catalogue-question" required maxlength="2000" placeholder={t('Ask a question',locale)}/><button type="submit" aria-label={t('Send question',locale)}>↑</button></form><button class="prepare-enquiry" type="button" data-rfq-start>{t('Prepare enquiry draft',locale)}</button></div></dialog>
<script id="ui-dictionary" type="application/json" set:html={JSON.stringify(dictionary).replace(/</g,'\u003c')}/>
