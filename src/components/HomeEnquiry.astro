---
import {urlFor,type Locale} from '../lib/routes';
interface Props {locale:Locale;}
const {locale}=Astro.props;
---
<section class="home-enquiry section" aria-labelledby="home-enquiry-title">
  <div><p class="eyebrow"><i></i> {locale==='zh'?'项目询价准备':'PROJECT ENQUIRY'}</p><h2 id="home-enquiry-title">{locale==='zh'?'把项目条件整理成可审核的询价草稿。':'Turn project requirements into a reviewable enquiry.'}</h2></div>
  <div class="enquiry-copy"><p>{locale==='zh'?'准备应用场景、产品系列、尺寸、数量、目的地和期望日期。草稿仅供工作人员后续审核，不会自动发送，也不代表价格、交期或工程批准。':'Prepare the application, product family, dimensions, quantity, destination and requested date. The draft is for staff review; it is not sent automatically and does not confirm price, delivery or engineering approval.'}</p><div class="enquiry-actions"><button type="button" data-rfq-start>{locale==='zh'?'准备询价草稿':'Prepare enquiry draft'} <span aria-hidden="true">→</span></button><a href={urlFor(locale,'contact')}>{locale==='zh'?'查看联系方式':'View contact details'}</a></div></div>
</section>
<style>
.home-enquiry{background:var(--ink);color:#f5f8f7;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:clamp(40px,8vw,120px);align-items:end;padding-block:clamp(64px,8vw,104px)}.home-enquiry h2{font-size:clamp(38px,5.5vw,72px);line-height:1.04;letter-spacing:-2.5px;margin:16px 0 0;max-width:900px}.enquiry-copy>p{font-size:17px;line-height:1.8;color:#c9d7de;margin:0;max-width:58ch}.enquiry-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:30px}.enquiry-actions button{min-height:48px;padding:0 20px;border:1px solid var(--aqua);background:var(--aqua);color:var(--ink);font-weight:800;cursor:pointer}.enquiry-actions a{min-height:44px;display:flex;align-items:center;color:#f5f8f7;font-weight:800;text-decoration:underline;text-underline-offset:5px}.enquiry-actions button:focus-visible,.enquiry-actions a:focus-visible{outline:3px solid var(--aqua);outline-offset:4px}@media(max-width:800px){.home-enquiry{grid-template-columns:1fr;gap:30px}.home-enquiry h2{letter-spacing:-1.6px}}
</style>
