---
import { urlFor, type Locale } from '../lib/routes';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = {
  zh: {
    eyebrow: '深圳海川集团 · 企业网站更新预览', first: '以技术连接', emphasis: '产业与生活。',
    intro: '了解海川在新材料、食品科技、环境技术和信息技术领域的业务。此版本供公司团队审阅，具体产品、资质及联系方式以确认后的资料为准。',
    business: '了解业务领域', contact: '联系我们', areas: '四个业务领域', group: '深圳集团概览', areaCount: '业务领域', languages: '语言版本',
  },
  en: {
    eyebrow: 'SHENZHEN OCEANPOWER · WEBSITE PREVIEW', first: 'Technology for ', emphasis: 'industry and everyday life.',
    intro: 'Explore Oceanpower’s work in new materials, food technology, environmental solutions and information technology. This preview is for company review; product, credential and contact details require confirmation.',
    business: 'Explore our businesses', contact: 'Contact us', areas: 'Four business areas', group: 'Shenzhen group overview', areaCount: 'Business areas', languages: 'Languages',
  },
  es: {
    eyebrow: 'OCEANPOWER SHENZHEN · VISTA PREVIA', first: 'Tecnología para ', emphasis: 'la industria y la vida cotidiana.',
    intro: 'Descubra las actividades de Oceanpower en nuevos materiales, tecnología alimentaria, soluciones ambientales y tecnología de la información. Esta versión está pendiente de revisión por la empresa; deben confirmarse los productos, las acreditaciones y los datos de contacto.',
    business: 'Explorar nuestras actividades', contact: 'Contacto', areas: 'Cuatro áreas de actividad', group: 'Grupo de Shenzhen', areaCount: 'Áreas de actividad', languages: 'Idiomas',
  },
  fr: {
    eyebrow: 'OCEANPOWER SHENZHEN · APERÇU DU SITE', first: 'La technologie au service ', emphasis: 'de l’industrie et du quotidien.',
    intro: 'Découvrez les activités d’Oceanpower dans les nouveaux matériaux, l’alimentaire, les solutions environnementales et les technologies de l’information. Cet aperçu doit être revu par l’entreprise ; les produits, certifications et coordonnées restent à confirmer.',
    business: 'Découvrir nos activités', contact: 'Nous contacter', areas: 'Quatre domaines d’activité', group: 'Groupe de Shenzhen', areaCount: 'Domaines d’activité', languages: 'Langues',
  },
}[locale];
const areas = [
  { slug: 'new-material', label: { zh: '新材料', en: 'New materials', es: 'Nuevos materiales', fr: 'Nouveaux matériaux' } },
  { slug: 'food', label: { zh: '食品科技', en: 'Food technology', es: 'Tecnología alimentaria', fr: 'Technologie alimentaire' } },
  { slug: 'environment', label: { zh: '环境技术', en: 'Environmental solutions', es: 'Soluciones ambientales', fr: 'Solutions environnementales' } },
  { slug: 'information', label: { zh: '信息技术', en: 'Information technology', es: 'Tecnología de la información', fr: 'Technologies de l’information' } },
] as const;
---
<div data-cms-entry="page:home"><section class="hero">
  <div class="hero-copy">
    <p class="eyebrow"><i></i> {copy.eyebrow}</p>
    <h1>{copy.first}<em>{copy.emphasis}</em></h1>
    <p class="hero-text">{copy.intro}</p>
    <div class="hero-actions"><a class="button primary" href={urlFor(locale,'business')}>{copy.business} <span aria-hidden="true">→</span></a><a class="text-link" href={urlFor(locale,'contact')}>{copy.contact} <span aria-hidden="true">→</span></a></div>
  </div>
  <div class="hero-visual" aria-label={copy.areas}>
    {areas.map((area,index)=><a class="hero-sector" href={urlFor(locale,'business/'+area.slug)}><img src={area.slug==='food'?'/assets/food-catalogue/flavour-powders.webp':'/assets/business-'+area.slug+'.jpg'} alt="" loading={index===0?'eager':'lazy'}/><span>{String(index+1).padStart(2,'0')} / {area.label[locale]} <b aria-hidden="true">↗</b></span></a>)}
  </div>
  <div class="hero-stats"><div><strong>SZ</strong><span>{copy.group}</span></div><div><strong>04</strong><span>{copy.areaCount}</span></div><div><strong>04</strong><span>{copy.languages}</span></div></div>
</section></div>
