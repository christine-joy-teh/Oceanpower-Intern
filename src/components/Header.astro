---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t } from '../i18n/ui';
import { urlFor, type Locale } from '../lib/routes';
import businesses from '../content/businesses.json';
interface Props { locale: Locale; route: string; }
const {locale,route}=Astro.props;
const links=[['Products','products'],['About','about'],['Research','research'],['Careers','careers'],['News','news']];
const divisionLabel={zh:'业务板块',en:'Business divisions',es:'Áreas de negocio',fr:'Domaines d’activité'}[locale];
---
<header class="site-header">
  <a class="brand" href={urlFor(locale)} aria-label={t('Home',locale)}><img class="brand-logo" src="/assets/oceanpower-logo.gif" width="191" height="90" alt="Oceanpower 海川股份" /></a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span><span class="menu-label">{t('Menu',locale)}</span></button>
  <nav id="site-nav" aria-label={t('Main navigation',locale)}>
    <div class="nav-business" data-business-menu>
      <a href={urlFor(locale,'business')} aria-current={route==='business'?'page':undefined} data-active={route.startsWith('business/')?'true':undefined}>{t('Business',locale)}</a>
      <button class="nav-business-toggle" type="button" aria-label={divisionLabel} aria-controls="business-submenu" aria-expanded="false"><span aria-hidden="true">⌄</span></button>
      <div class="business-submenu" id="business-submenu" hidden>
        {businesses.map(item=><a href={urlFor(locale,'business/'+item.slug)} aria-current={route==='business/'+item.slug?'page':undefined}>{t(item.label,locale)}</a>)}
      </div>
    </div>
    {links.map(([label,path])=><a href={urlFor(locale,path)} aria-current={route===path?'page':undefined}>{t(label,locale)}</a>)}
    <a class="mobile-quote" href={urlFor(locale,'contact')} aria-current={route==='contact'?'page':undefined}>{t('Contact',locale)}</a>
  </nav>
  <LanguageSwitcher locale={locale} route={route}/>
  <a class="header-cta" href={urlFor(locale,'contact')} aria-current={route==='contact'?'page':undefined}>{t('Contact',locale)} <span aria-hidden="true">→</span></a>
</header>
