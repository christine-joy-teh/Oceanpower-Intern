---
import products from '../content/product-examples.json';
import {categoryPortfolios,local} from '../content/catalogue';
import officialProducts from '../content/official-products.json';
import {t} from '../i18n/ui';
import {urlFor,type Locale} from '../lib/routes';
const {locale}=Astro.props as {locale:Locale};
---
<section class="section product-category-overview">
<p class="eyebrow dark">OCEANPOWER</p><h1>{t('Products',locale)}</h1>
<p>{locale==='zh'?'按材料类别浏览产品。重点产品根据新版手册整理；各分类下方另有可搜索的海川新材官网产品档案。':'Browse by material category. Featured products draw on the newer manuals; each category also has a searchable archive of entries from Oceanpower New Materials’ official site.'}</p>
<section class="cms-managed-section" aria-labelledby="cms-products-heading" hidden data-cms-products><h2 id="cms-products-heading">{locale==='zh'?'最新产品':'Latest products'}</h2><div class="cms-entry-grid"></div></section>
<div class="product-examples">{products.map(product=>{const portfolio=categoryPortfolios[product.route as keyof typeof categoryPortfolios];const archive=officialProducts.categories.find(category=>category.route===product.route);return <article>
{product.image?<img src={product.image} alt={t(product.name,locale)} width="480" height="320" loading="lazy"/>:<div class="category-cover" aria-hidden="true">{t(product.category,locale)}</div>}
<div class="example-content"><h2 class="category">{t(product.category,locale)}</h2><h3>{portfolio?local(portfolio.products[0].name,locale):t(product.name,locale)}</h3>
{portfolio&&<p class="catalogue-count">{portfolio.products.length} {locale==='zh'?'个目录产品 / 解决方案':'catalogue products / solutions'}</p>}
{archive&&<p class="catalogue-count">{archive.entries.length} {locale==='zh'?'条官网产品档案':'official-site archive entries'}</p>}
<a href={product.route?urlFor(locale,product.route):product.source} target={product.route?undefined:'_blank'} rel={product.route?undefined:'noopener noreferrer'}>{t('View more',locale)} <span aria-hidden="true">{product.route?'→':'↗'}</span></a></div>
</article>})}</div>
<section class="cms-managed-section" aria-labelledby="cms-documents-heading" hidden data-cms-documents><h2 id="cms-documents-heading">{locale==='zh'?'下载文件':'Downloads'}</h2><div class="cms-document-list"></div></section>
</section>
<style>
.product-category-overview h1{font-size:clamp(2.5rem,6vw,5rem);margin:1rem 0}.product-category-overview>p{max-width:820px;font-size:18px;line-height:1.75}
.product-examples{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:40px}
article{border:1px solid #d9ddd8;border-top:4px solid #28699d;background:white;display:flex;flex-direction:column;min-width:0}
img{width:100%;height:230px;object-fit:contain;background:#f5f7f7;padding:16px;box-sizing:border-box}
.category-cover{height:230px;box-sizing:border-box;display:flex;align-items:center;padding:32px;background:#e1eef3;color:#28699d;font-size:1.75rem;font-weight:700}
.example-content{padding:24px;display:flex;flex-direction:column;flex:1}.example-content .category{font-size:1.05rem;line-height:1.45;letter-spacing:normal;color:#28699d;margin:0 0 12px}.example-content h3{font-size:1.35rem;line-height:1.45;margin:0 0 18px;overflow-wrap:anywhere}.catalogue-count{font:500 11px/1.5 'DM Mono',monospace;color:#52677b;margin:0 0 24px}.example-content a{margin-top:auto;min-height:44px;display:flex;align-items:center;gap:8px;font-weight:700}.example-content a:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
@media(max-width:1000px){.product-examples{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.product-examples{grid-template-columns:1fr}}
</style>
