---
import {categoryPortfolios,local} from '../content/catalogue';
import {t} from '../i18n/ui';
import {urlFor,type Locale} from '../lib/routes';
import AirportSolutionDetail from './AirportSolutionDetail.astro';
import AsphaltSolutionDetail from './AsphaltSolutionDetail.astro';
import OfficialProductArchive from './OfficialProductArchive.astro';
import officialProducts from '../content/official-products.json';
interface Props {locale:Locale;category:{category:string;route:string;content:Record<string,string[]>};}
const {locale,category}=Astro.props;
const portfolio:any=categoryPortfolios[category.route as keyof typeof categoryPortfolios];
const officialCategory=officialProducts.categories.find(item=>item.route===category.route);
const display=(value:any)=>typeof value==='string'?value:local(value,locale);
const pageTitle=category.route==='products/integrated-solutions'
  ? (locale==='zh'?'机场道面材料解决方案':'Airport pavement material solution')
  : category.route==='products/asphalt-based-products'
    ? (locale==='zh'?'道路沥青材料与铺装体系':'Road asphalt materials and surfacing systems')
    : t(category.category,locale);
---
<section class="section category-page">
  <a class="category-back" href={urlFor(locale,'products')}>← {t('Products',locale)}</a>
  <p class="eyebrow dark">{portfolio?.eyebrow || 'OCEANPOWER'}</p>
  <h1>{pageTitle}</h1>
  {officialCategory&&<a class="archive-jump" href={'#official-'+officialCategory.id}>{locale==='zh'?`浏览 ${officialCategory.entries.length} 条官网产品档案`:`Browse ${officialCategory.entries.length} official-site entries`} <span aria-hidden="true">↓</span></a>}
  {portfolio ? <>
    <div class="category-intro"><p>{local(portfolio.intro,locale)}</p><aside><strong>{locale==='zh'?'内容状态':'CONTENT STATUS'}</strong><span>{locale==='zh'?'新增目录来源 · 公司审核状态未核实':'New catalogue source · Company approval not verified'}</span></aside></div>
    <div class="category-notice"><strong>{locale==='zh'?'使用说明':'Use this information carefully'}</strong><p>{local(portfolio.notice,locale)}</p></div>
    <nav class="category-index" aria-label={locale==='zh'?'本页产品':'Products on this page'}>{portfolio.products.map((product:any)=><a href={'#'+product.id}>{local(product.name,locale)}</a>)}</nav>
    <div class="catalogue-product-list">
      {portfolio.products.map((product:any,index:number)=><article id={product.id}>
        <header><span>{String(index+1).padStart(2,'0')}</span><div><h2>{local(product.name,locale)}</h2><p>{local(product.summary,locale)}</p></div></header>
        <dl class="catalogue-facts">{product.facts.map((fact:any)=><div><dt>{display(fact.label)}</dt><dd>{display(fact.value)}</dd></div>)}</dl>
        {product.details?.length&&<div class="catalogue-details">{product.details.map((detail:any)=><section><h3>{local(detail.title,locale)}</h3><ul>{detail.items.map((item:any)=><li>{local(item,locale)}</li>)}</ul></section>)}</div>}
        <div class="catalogue-applications"><h3>{locale==='zh'?'主要应用':'Primary applications'}</h3><ul>{product.applications.map((application:any)=><li>{local(application,locale)}</li>)}</ul></div>
        <footer><p>{local(product.source,locale)}</p>{'href' in product&&product.href&&<a href={urlFor(locale,product.href)}>{locale==='zh'?'查看完整产品页':'View full product page'} <span aria-hidden="true">→</span></a>}</footer>
      </article>)}
    </div>
    {category.route==='products/asphalt-based-products'&&<AsphaltSolutionDetail locale={locale}/>}
    {category.route==='products/integrated-solutions'&&<AirportSolutionDetail locale={locale}/>}
  </> : <div class="category-content">{category.content[locale]?.map(paragraph=><p>{paragraph}</p>)}</div>}
  <OfficialProductArchive locale={locale} route={category.route}/>
</section>
<style>
.category-page{min-height:65vh}.category-back{display:inline-flex;min-height:44px;align-items:center;color:var(--blue);font-weight:700}.category-page>h1{font-size:clamp(38px,6vw,72px);letter-spacing:-2px;line-height:1.05;margin:26px 0 36px;max-width:1100px}.archive-jump{display:inline-flex;min-height:44px;align-items:center;gap:10px;margin:-16px 0 36px;color:var(--blue);font-weight:800}.archive-jump:focus-visible{outline:3px solid var(--blue);outline-offset:4px}.category-intro{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.5fr);gap:48px;align-items:start}.category-intro>p{font-size:clamp(18px,2vw,24px);line-height:1.65;margin:0;max-width:900px}.category-intro aside{border-top:3px solid var(--aqua);padding-top:14px;display:grid;gap:8px}.category-intro aside strong{font:500 11px/1.4 'DM Mono',monospace;letter-spacing:.08em}.category-intro aside span{font-size:13px;line-height:1.6;color:#52677b}.category-notice{margin:40px 0 28px;padding:22px 26px;background:#e9efee;border-left:3px solid var(--blue)}.category-notice p{line-height:1.7;margin:8px 0 0;max-width:1000px}.category-index{display:flex;gap:8px;overflow-x:auto;padding:4px 0 24px;scrollbar-width:thin}.category-index a{flex:0 0 auto;min-height:44px;display:flex;align-items:center;padding:0 16px;border:1px solid var(--line);background:white;color:var(--ink);font-size:13px;font-weight:700}.category-index a:hover,.category-index a:focus-visible{border-color:var(--blue);color:var(--blue)}.catalogue-product-list{display:grid;gap:28px}.catalogue-product-list article{scroll-margin-top:110px;border:1px solid var(--line);background:#fff;padding:clamp(24px,4vw,48px)}.catalogue-product-list article>header{display:grid;grid-template-columns:64px minmax(0,1fr);gap:24px;border-bottom:1px solid var(--line);padding-bottom:28px}.catalogue-product-list article>header>span{font:500 26px/1 'DM Mono',monospace;color:var(--aqua);background:var(--ink);width:52px;height:52px;display:grid;place-items:center}.catalogue-product-list h2{font-size:clamp(27px,3.5vw,44px);line-height:1.15;letter-spacing:-1px;margin:0 0 12px}.catalogue-product-list header p{line-height:1.75;margin:0;max-width:820px;color:#455c73}.catalogue-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));margin:28px 0;border-top:1px solid var(--line);border-left:1px solid var(--line)}.catalogue-facts div{padding:18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-width:0}.catalogue-facts dt{font-size:12px;line-height:1.45;color:#52677b;margin-bottom:8px}.catalogue-facts dd{margin:0;font-weight:800;line-height:1.45;overflow-wrap:anywhere}.catalogue-details{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin:0 0 28px}.catalogue-details section{padding:22px 24px;background:#eef3f1;border-top:3px solid var(--aqua)}.catalogue-details h3{font-size:16px;margin:0 0 12px}.catalogue-details ul{margin:0;padding-left:18px;display:grid;gap:8px}.catalogue-details li{font-size:14px;line-height:1.65}.catalogue-applications h3{font-size:16px;margin:0 0 12px}.catalogue-applications ul{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}.catalogue-applications li{padding:9px 12px;background:#f0f4f2;font-size:13px;line-height:1.45}.catalogue-product-list footer{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:end;margin-top:28px;padding-top:20px;border-top:1px solid var(--line)}.catalogue-product-list footer p{font-size:12px;line-height:1.7;color:#52677b;margin:0;max-width:850px}.catalogue-product-list footer a{color:var(--blue);font-weight:800;white-space:nowrap}.category-content{max-width:960px;line-height:1.8}@media(max-width:800px){.category-intro{grid-template-columns:1fr;gap:28px}.catalogue-product-list footer{grid-template-columns:1fr;gap:18px}.catalogue-product-list footer a{white-space:normal;min-height:44px;display:flex;align-items:center}}@media(max-width:520px){.catalogue-product-list article{padding:22px 16px}.catalogue-product-list article>header{grid-template-columns:1fr;gap:16px}.catalogue-facts,.catalogue-details{grid-template-columns:1fr}}
</style>
