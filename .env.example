# Copy this file to .env for local use. Never commit the real API key.
PORT=8000

# MaxKB, FastGPT, or another OpenAI-compatible chat endpoint.
# MaxKB example:
# CHAT_API_URL=https://ai.example.com/api/application/APP_ID/chat/completions
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=Oceanpower Sales Assistant

# Optional comma-separated website origins allowed to call the API.
# Leave empty when the website and API use the same domain.
ALLOWED_ORIGINS=
