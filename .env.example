# Copy this file to .env for local use. Never commit the real API key.
PORT=8000

# Recommended no-MaxKB pilot: call Qwen directly through Alibaba Cloud Model Studio.
# Copy the exact China (Beijing) endpoint shown in your Model Studio workspace.
# Example format:
# CHAT_API_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=qwen-flash

# This approved file is inserted into the server-side system prompt so the
# direct model can answer from Oceanpower facts without a separate RAG server.
CHAT_KNOWLEDGE_FILE=knowledge/oceanpower-approved-knowledge.md

# Optional comma-separated website origins allowed to call the API.
# Leave empty when the website and API use the same domain.
ALLOWED_ORIGINS=
