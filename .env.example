# Copy this file to .env for local use. Never commit the real API key.
PORT=8000
# Keep this loopback-only for local use. Set HOST=0.0.0.0 on Render.
HOST=127.0.0.1

# Recommended no-MaxKB pilot: call Qwen directly through Alibaba Cloud Model Studio.
# Copy the exact China (Beijing) endpoint shown in your Model Studio workspace.
# Example format:
# CHAT_API_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
CHAT_API_URL=
CHAT_API_KEY=
# Required when CHAT_API_URL/CHAT_API_KEY are set. Use the provider's exact model ID.
CHAT_MODEL=qwen-flash

# This draft file is inserted into the server-side system prompt so the direct
# model can answer from the pilot facts without a separate RAG server.
CHAT_KNOWLEDGE_FILE=knowledge/oceanpower-approved-knowledge.md

# Optional comma-separated website origins allowed to call the API.
# Leave empty when the website and API use the same domain.
ALLOWED_ORIGINS=

# Astro SEO: leave indexing disabled for the demo.
SITE_URL=https://www.oceanpower.com
PUBLIC_INDEXABLE=false
ASTRO_TELEMETRY_DISABLED=1

# Optional shared secret for a separately hosted Node chat backend and Pages bridge.
# Cloudflare Pages also needs CHAT_BACKEND_URL=https://your-node-backend.example
CHAT_BACKEND_TOKEN=

# Local website content manager (MySQL 8+). Keep real values in .env only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=oceanpower_cms
MYSQL_USER=oceanpower_cms
MYSQL_PASSWORD=YOUR_DATABASE_PASSWORD
MYSQL_SSL_MODE=DISABLED
# MYSQL_SSL_CA_FILE=certs/database-ca.pem

# Fixed local content-manager login. Change these values to change the staff login.
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=oceanpower
